# ============================================================
# AMOUR AFFAIRS — web root (/amouraffairs.in/.htaccess)
# ------------------------------------------------------------
# Source of truth for the live root .htaccess. Deployed by
# scripts/deploy.sh (server step). The admin subdomain's own
# rules live in server/admin/.htaccess and inherit these first
# (RewriteOptions InheritBefore), so every redirect below is
# guarded by the main site's host name.
# ============================================================

Options -Indexes
Options +FollowSymLinks

RewriteEngine On

# ── 1. HTTP → HTTPS on the canonical www host (permanent) ──
RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?amouraffairs\.in$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://www.amouraffairs.in/$1 [R=301,L]

# ── 2. Bare domain → www (permanent), one URL per page for Google ──
# /api/ and /uploads/ stay reachable on the bare domain: the dashboard calls
# https://amouraffairs.in/api, and redirecting its cross-origin requests would
# break them.
RewriteCond %{HTTP_HOST} ^amouraffairs\.in$ [NC]
RewriteCond %{REQUEST_URI} !^/(api|uploads)/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://www.amouraffairs.in/$1 [R=301,L]

# ── 3. The admin subdomain's folder handles its own rules ──
RewriteRule ^amour-admin/ - [L]

# ── 4. Leftovers of the pre-2026 site: gone for good ──
# 410 tells search engines to drop these URLs instead of re-checking them.
RewriteCond %{HTTP_HOST} ^(www\.)?amouraffairs\.in$ [NC]
RewriteRule ^(html|images|css|js|includes|common-css-js|nbproject|PHPMailer|watermark|bg-frames|gallery|how-we-work)(/.*)?$ - [G,L]

# ── 5. Dynamic XML sitemap (always lists the published guides & case studies) ──
RewriteRule ^sitemap\.xml$ api/sitemap.php [L]

# ── 6. Serve real files and folders as-is (the static Vite build) ──
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── 7. Responsive sizes of CMS photos ──
# /uploads/_w/<width>/<path>.webp is a static file once made; the first
# request for a size reaches api/img.php, which creates it.
RewriteRule ^uploads/_w/(480|800|1200|1600)/(.+\.webp)$ api/img.php?w=$1&p=$2 [L]

# ── 8. Clean URLs for CMS guides and case studies ──
# Anything reaching here is a slug — route it to the shared template, which
# reads the slug from the path and loads the article from the API.
RewriteRule ^guides/([^/]+)/?$ /guides/_post/index.html [L]
RewriteRule ^case-studies/([^/]+)/?$ /case-studies/_story/index.html [L]

# Branded error pages
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ════════════════════════════════════════════════════════════
# PERFORMANCE — text compression + long-lived caching
# ════════════════════════════════════════════════════════════

# This host serves .js as `text/javascript`, so that type MUST be listed or
# the JS bundles ship uncompressed. (No Brotli on this host; gzip only.)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json image/svg+xml application/xml application/rss+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json image/svg+xml application/xml application/rss+xml
</IfModule>
# Fallback for older mod_deflate where AddOutputFilterByType is unreliable.
<IfModule mod_deflate.c>
  <FilesMatch "\.(js|mjs|css|svg|json|xml)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Fingerprinted build assets — cache for a year
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  # Images, video, fonts
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  # HTML + data — revalidate so content edits show up immediately
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType application/json        "access plus 0 seconds"
  ExpiresByType application/xml         "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|woff2?|svg|png|jpe?g|gif|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
