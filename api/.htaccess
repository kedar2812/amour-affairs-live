# ============================================================
# AMOUR AFFAIRS — API Security Rules
# ============================================================
# Prevents direct access to sensitive files.
# Place in the /api/ directory.
# ============================================================

# Deny access to config and internal files.
# `.*\.test\.php` matters: test files must never be executable over HTTP, and
# `jsonl` keeps the enquiry spool private even if its directory guard is missing.
<FilesMatch "(\.(sql|md|txt|log|ini|jsonl)|\.test\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to seed.php in production (uncomment after seeding)
# <Files "seed.php">
#     Order Allow,Deny
#     Deny from all
# </Files>

# ── Pass the HTTP Authorization header through to PHP ──
# Under FastCGI/CGI (this host) Apache does NOT expose the Authorization header
# to PHP by default, so JWT Bearer-token auth silently fails with 401 and the
# dashboard bounces back to the login screen. Republish it as an env var that
# getBearerToken() reads ($_SERVER['HTTP_AUTHORIZATION'] / REDIRECT_*).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Block directory listing
Options -Indexes

# Force UTF-8
AddDefaultCharset UTF-8

# Set PHP settings for security
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value upload_max_filesize 64M
    php_value post_max_size 512M
    php_value memory_limit 512M
    php_value max_execution_time 300
</IfModule>
