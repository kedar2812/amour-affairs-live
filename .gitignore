# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
.vite/

# ── Local environment & editor noise ─────────────────────────
.DS_Store
Thumbs.db
.env
.env.local
*.log

# ── Secrets: NEVER commit (this repository is public) ────────
api/config.secrets.php
hosting details (ignore in github)/

# ── Local-only material ──────────────────────────────────────
# _local/  source photos, 3D renders, client documents, archived one-off
#          scripts and migration runners (they carry access tokens)
# _deploy/ server backups and deploy logs (contain live secrets)
_local/
_deploy/

# Local test uploads (the live uploads exist only on the server)
/uploads/

# ── API runtime data (server only) ───────────────────────────
api/spool/
api/logs/

# One-time migration runners carry a hardcoded access token; they are run
# once on the server and deleted. Keep them in _local/migration-runners/.
api/_migrate_*.php

# Backup restore staging + safety snapshots (server runtime data)
api/backups/
